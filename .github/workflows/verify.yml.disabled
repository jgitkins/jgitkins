name: verify

on:
  push:
    branches:
      - develop
  workflow_dispatch:

permissions:
  contents: read

concurrency:
  group: verify-${{ github.ref }}
  cancel-in-progress: true

jobs:
  detect:
    runs-on: ubuntu-latest
    outputs:
      server: ${{ steps.filter.outputs.server }}
      web: ${{ steps.filter.outputs.web }}
      runner: ${{ steps.filter.outputs.runner }}
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - id: filter
        shell: bash
        env:
          EVENT_BEFORE: ${{ github.event.before }}
          SERVER_PATTERN: '^(app-server/|core-common/|core-security/|core-persistence/|core-grpc/|settings\.gradle$|\.github/workflows/verify\.yml$|\.github/workflows/app-server-verify\.yml$)'
          WEB_PATTERN: '^(app-web/|core-common/|core-web/|core-security/|settings\.gradle$|\.github/workflows/verify\.yml$|\.github/workflows/app-web-verify\.yml$)'
          RUNNER_PATTERN: '^(app-runner/|core-common/|core-grpc/|settings\.gradle$|\.github/workflows/verify\.yml$|\.github/workflows/app-runner-verify\.yml$)'
        run: |
          bash .github/scripts/detect-changed-modules.sh

  server:
    needs: detect
    if: needs.detect.outputs.server == 'true'
    uses: ./.github/workflows/app-server-verify.yml

  web:
    needs: detect
    if: needs.detect.outputs.web == 'true'
    uses: ./.github/workflows/app-web-verify.yml

  runner:
    needs: detect
    if: needs.detect.outputs.runner == 'true'
    uses: ./.github/workflows/app-runner-verify.yml
